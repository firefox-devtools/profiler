{
  "presets": [
    "@babel/preset-env",
    [
      "@babel/preset-react",
      {
        // Automatically import 'react' into .tsx files.
        "runtime": "automatic"
      }
    ],
    "@babel/preset-typescript"
  ],
  // With `setPublicClassFields`, fields are assigned instead of being defined
  // with `Object.defineProperty`.
  "assumptions": {
    "setPublicClassFields": true,
    "privateFieldsAsProperties": true
  },
  "plugins": [
    // Class fields are native in our Node test target, so `@babel/preset-env`
    // doesn't transform them. We still transform them explicitly so that the
    // assumptions above apply to them.
    "@babel/plugin-transform-class-properties",
    "@babel/plugin-transform-private-methods",
    "@babel/plugin-transform-private-property-in-object",
    [
      "module-resolver",
      {
        "alias": {
          "firefox-profiler": "./src",
          "firefox-profiler-res": "./res"
        }
      }
    ]
  ]
}
